# Copia este archivo a .env y completa los valores

# Service Account de Google Cloud con permisos de Firebase App Distribution Admin
# Pega el contenido del JSON como una sola línea (stringify del JSON)
GOOGLE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...",...}'

# ID del proyecto Firebase (ej: tunay-wasi)
FIREBASE_PROJECT_ID=tunay-wasi

# App ID de Firebase (ej: 1:399522765847:android:98ef173a366e5ba6ddd052)
FIREBASE_APP_ID=1:399522765847:android:98ef173a366e5ba6ddd052

# Cuenta Gmail que envía los emails (la misma que ya usas en Firebase Functions)
GMAIL_USER=tunaywasi@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Origen permitido para CORS (URL del landing, ej: https://tunay-wasi.web.app)
# Usa * para desarrollo local
ALLOWED_ORIGIN=*
